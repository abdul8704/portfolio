---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Rail from '../components/Rail.astro';
import Card from '../components/Card.astro';
import FlowDiagram from '../components/FlowDiagram.astro';
import BranchTimeline from '../components/BranchTimeline.astro';
import SolvedStats from '../components/SolvedStats.astro';
import { getSolvedStats } from '../lib/algomentor.js';
import { listItems } from '../lib/store.js';
import { siteContext, fmtDate, personLd, websiteLd, pageLd, hasPlaceholder } from '../lib/seo.js';
import { readingMinutes } from '../lib/markdown.js';
import { resumeLink } from '../lib/resume.js';

const { profile, origin, drafts } = await siteContext(Astro);
const timeline = await listItems('timeline', { drafts });
const allProjects = await listItems('project', { drafts });
const allAchievements = await listItems('achievement', { drafts });
const allCerts = await listItems('certification', { drafts });
const lim = (v) => Math.min(50, Math.max(1, parseInt(v, 10) || 3));
const projects = allProjects.slice(0, lim(profile.homeProjects));
const achievements = allAchievements.slice(0, lim(profile.homeAchievements));
const certs = allCerts.slice(0, lim(profile.homeCerts));
const skills = await listItems('skill', { drafts });
const allPosts = await listItems('post', { drafts });
const posts = allPosts.slice(0, lim(profile.homePosts));
const solved = await getSolvedStats(profile.algomentorHandle);
const resume = resumeLink(profile);

const nav = [
  ['About', '#about', true],
  ...(timeline.length ? [['Timeline', '#timeline', true]] : []),
  ...(projects.length ? [['Projects', '#projects', true]] : []),
  ...(solved ? [['Problem solving', '#problem-solving', true]] : []),
  ...(achievements.length ? [['Achievements', '#achievements', true]] : []),
  ...(certs.length ? [['Certifications', '#certifications', true]] : []),
  ...(allPosts.length ? [['Blog', '/blog', false]] : []),
];
let n = 0;
const num = () => String(++n).padStart(2, '0');

const title = profile.seoTitle || `${profile.name}, ${profile.role}`;
const description = profile.seoDescription || `${profile.summary} ${profile.about?.[0] || ''}`;
const url = origin + '/';
const graph = [
  websiteLd(profile, origin),
  await personLd(profile, origin, {
    skills: skills.flatMap((s) => s.items),
    achievements: achievements.map((a) => a.title).filter((t) => !hasPlaceholder(t)),
  }),
  { ...pageLd(url, title, description, origin, profile.ogImage ? origin + profile.ogImage : ''), '@type': 'ProfilePage', mainEntity: { '@id': `${origin}/#person` } },
];
---
<Base profile={profile} owner={!!Astro.locals.owner} graph={graph}
  seo={{ title, description, path: '/', origin, image: profile.ogImage, imageAlt: profile.ogImageAlt }}>
  <div class="shell">
    <Rail profile={profile} skills={skills} nav={nav} />

    <main class="content" id="main" data-content>
      <div class="hero-spacer" data-hero-spacer aria-hidden="true"></div>
      <section id="about" class="about" aria-labelledby="hero">
        <h2 class="hero-title" id="hero">
          {(profile.headline.length ? profile.headline : [profile.role]).map((line, i) => <span class="line"><span style={`--i:${i}`}>{line}</span></span>)}
        </h2>
        <div data-reveal>
          {profile.about.map((p) => <p>{p}</p>)}
          {profile.status && <span class="status">{profile.status}</span>}
          <div class="about-actions">
            {resume && <a class="btn-link" href={resume.href} {...(resume.viewer ? { target: '_blank', rel: 'noopener', 'data-resume-viewer': '' } : {})} data-magnetic>Résumé <span aria-hidden="true">↗</span></a>}
            {profile.email && <a class="btn-link" href={`mailto:${profile.email}`} data-magnetic>Get in touch <span aria-hidden="true">↗</span></a>}
          </div>
        </div>
        <FlowDiagram />
      </section>

      {timeline.length > 0 && (
        <section id="timeline" aria-labelledby="h-timeline">
          <h2 class="section-title" id="h-timeline"><b>{num()}</b>Timeline</h2>
          <BranchTimeline items={timeline} />
        </section>
      )}

      {projects.length > 0 && (
        <section id="projects" aria-labelledby="h-projects">
          <h2 class="section-title" id="h-projects"><b>{num()}</b>Projects</h2>
          <ul class="card-list dim-list" data-stagger>
            {projects.map((p) => (
              <Card href={`/projects/${p.slug}`} title={p.name} desc={p.blurb} result={p.outcome} tags={p.stack}
                image={p.image} alt={p.imageAlt} transitionName={`t-project-${p.slug}`} meta={p.published ? '' : 'Draft'} />
            ))}
          </ul>
          {allProjects.length > projects.length && <p class="more" data-reveal><a class="btn-link" href="/projects" data-magnetic>All projects ({allProjects.length}) <span aria-hidden="true">→</span></a></p>}
        </section>
      )}

      {solved && <SolvedStats stats={solved} link={profile.algomentorLink} num={num()} />}

      {achievements.length > 0 && (
        <section id="achievements" aria-labelledby="h-achievements">
          <h2 class="section-title" id="h-achievements"><b>{num()}</b>Achievements</h2>
          <ul class="card-list dim-list" data-stagger>
            {achievements.map((a) => (
              <Card href={`/achievements/${a.slug}`} title={a.title} kind={a.kind} meta={[a.event, a.year].filter(Boolean).join(' · ')}
                desc={a.note} image={a.image} alt={a.imageAlt} transitionName={`t-achievement-${a.slug}`} />
            ))}
          </ul>
          {allAchievements.length > achievements.length && <p class="more" data-reveal><a class="btn-link" href="/achievements" data-magnetic>All achievements ({allAchievements.length}) <span aria-hidden="true">→</span></a></p>}
        </section>
      )}

      {certs.length > 0 && (
        <section id="certifications" aria-labelledby="h-certs">
          <h2 class="section-title" id="h-certs"><b>{num()}</b>Certifications</h2>
          <ul class="card-list dim-list" data-stagger>
            {certs.map((c) => (
              <Card href={`/certifications/${c.slug}`} title={c.name} meta={[c.issuer, c.year].filter(Boolean).join(' · ')}
                desc={c.note} image={c.image} alt={c.imageAlt} transitionName={`t-certification-${c.slug}`} />
            ))}
          </ul>
          {allCerts.length > certs.length && <p class="more" data-reveal><a class="btn-link" href="/certifications" data-magnetic>All certifications ({allCerts.length}) <span aria-hidden="true">→</span></a></p>}
        </section>
      )}

      {allPosts.length > 0 && (
      <section id="writing" aria-labelledby="h-writing">
        <h2 class="section-title" id="h-writing"><b>{num()}</b>Writing</h2>
        <ul class="dim-list" data-stagger>
            {posts.map((p) => (
              <li class="post dim-item" data-reveal data-cursor-label="Read">
                <span class="card-kicker">{fmtDate(p.date)} · {readingMinutes(p.body)} min read{!p.published && ' · Draft'}</span>
                <h3><a href={`/blog/${p.slug}`}>{p.title}</a> <span class="arrow" aria-hidden="true">↗</span></h3>
                <p>{p.description}</p>
              </li>
            ))}
        </ul>
        {allPosts.length > posts.length && <p class="more" data-reveal><a class="btn-link" href="/blog" data-magnetic>All posts ({allPosts.length}) <span aria-hidden="true">→</span></a></p>}
      </section>
      )}

      <footer class="foot">
        <p class="foot-id"><Logo size={18} />© {new Date().getFullYear()} {profile.name}</p>
        <p><a href="/rss.xml">RSS</a> · <a href="/llms.txt">llms.txt</a> · <a href="/sitemap.xml">Sitemap</a></p>
      </footer>
    </main>
  </div>
  <a class="scroll-hint" href="#about" data-scroll-hint aria-hidden="true" tabindex="-1"><span>scroll</span><i></i></a>
</Base>
