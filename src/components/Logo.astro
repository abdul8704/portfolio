---
// The mark: an "A" drawn as a small graph (one source node fanning out to two), for a backend developer.
// Colours follow the page tokens, so it picks up the accent colour chosen in the admin.
const { size = 24, class: cls = '' } = Astro.props;
---
<svg class={`logo ${cls}`} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="8" fill="var(--surface-base)" />
  <rect x=".5" y=".5" width="31" height="31" rx="7.5" fill="none" stroke="var(--action)" stroke-opacity=".28" />
  <g fill="none" stroke="var(--action)" stroke-linecap="round" stroke-linejoin="round">
    <path d="M7.5 25 16 6.5 24.5 25" stroke-width="2.3" />
    <path d="M11.4 19.6h9.2" stroke-width="2" />
  </g>
  <circle cx="16" cy="6.5" r="2.8" fill="var(--action)" />
  <circle cx="7.5" cy="25" r="2" fill="var(--surface-base)" stroke="var(--action)" stroke-width="1.8" />
  <circle cx="24.5" cy="25" r="2" fill="var(--surface-base)" stroke="var(--action)" stroke-width="1.8" />
</svg>
