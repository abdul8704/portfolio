---
// Problem-solving stats from AlgoMentor. One total up top, then a card per
// platform. Cards are all the same size and never share a scale: each leads
// with the number that matters there (contest rating, share of a fixed problem
// set, or solved count), and its difficulty bar is a split of that platform only,
// so a big practice site doesn't dwarf a small, hard one.
import { ALGOMENTOR_URL } from '../lib/algomentor.js';
const { stats, link, num } = Astro.props;
const fmt = (n) => n.toLocaleString('en-US');
const pct = (n, of) => (of > 0 ? (n / of) * 100 : 0);
const split = (s) =>
  [['easy', 'Easy', s.easy], ['medium', 'Medium', s.medium], ['hard', 'Hard', s.hard], ['other', 'Unrated', s.other]]
    .filter(([, , n]) => n > 0);
const diffs = split(stats);
const href = link || ALGOMENTOR_URL;
const n = stats.platforms.length;

function head(p) {
  if (p.headline === 'rating') return {
    value: fmt(p.rating), unit: 'rating',
    sub: [p.maxRating && p.maxRating > p.rating && `peak ${fmt(p.maxRating)}`, `${fmt(p.solved)} solved`],
  };
  if (p.headline === 'catalog') return {
    value: fmt(p.solved), of: fmt(p.catalog), unit: 'of the problem set',
    sub: [`${Math.round(pct(p.solved, p.catalog))}% complete`],
    progress: Math.min(100, pct(p.solved, p.catalog)),
  };
  return {
    value: fmt(p.solved), unit: 'solved',
    sub: [p.hard && `${fmt(p.hard)} hard`, p.rating && `contest rating ${fmt(p.rating)}`],
  };
}
---
<section id="problem-solving" aria-labelledby="h-solving">
  <h2 class="section-title" id="h-solving"><b>{num}</b>Problem solving</h2>
  <div class="ps" data-reveal>
    <div class="ps-head">
      <p class="ps-total">
        <span class="ps-num">{fmt(stats.solved)}</span>
        <span class="ps-cap">problems solved{n > 1 && <> across <b>{n} platforms</b></>}</span>
      </p>
      <div class="ps-split" role="img" aria-label={diffs.map(([, l, v]) => `${l} ${v}`).join(', ')}>
        <div class="ps-bar">
          {diffs.map(([k, , v]) => <i class={`d-${k}`} style={`--w:${pct(v, stats.solved).toFixed(2)}%`}></i>)}
        </div>
        <ul class="ps-legend" aria-hidden="true">
          {diffs.map(([k, l, v]) => <li class={`d-${k}`}><span>{l}</span> <b>{fmt(v)}</b></li>)}
        </ul>
      </div>
    </div>

    {n > 0 && (
      <ul class="ps-cards" data-stagger>
        {stats.platforms.map((p) => {
          const h = head(p);
          const d = split(p).filter(([k]) => k !== 'other' || p.easy + p.medium + p.hard > 0);
          return (
            <li class={`ps-card ps-${p.key}`}>
              <span class="ps-name">{p.label}</span>
              <p class="ps-big">
                <b>{h.value}</b>{h.of && <span class="ps-of">/ {h.of}</span>}
                <span class="ps-unit">{h.unit}</span>
              </p>
              {h.progress != null && (
                <span class="ps-progress" role="img" aria-label={`${h.sub[0]}`}><i style={`--w:${h.progress.toFixed(2)}%`}></i></span>
              )}
              <p class="ps-sub">{h.sub.filter(Boolean).join(' · ')}</p>
              {d.length > 0 ? (
                <div class="ps-mix">
                  <span class="ps-bar ps-bar-sm" role="img" aria-label={`${p.label} by difficulty: ${d.map(([, l, v]) => `${l} ${v}`).join(', ')}`}>
                    {d.map(([k, , v]) => <i class={`d-${k}`} style={`--w:${pct(v, p.solved).toFixed(2)}%`}></i>)}
                  </span>
                  <span class="ps-mix-t" aria-hidden="true">
                    {d.map(([k, l, v]) => <span class={`d-${k}`}>{fmt(v)} {l.toLowerCase()}</span>)}
                  </span>
                </div>
              ) : (
                <p class="ps-mix-none">No difficulty labels on this platform</p>
              )}
            </li>
          );
        })}
      </ul>
    )}

    <div class="ps-foot">
      <a class="btn-link" href={href} target="_blank" rel="noopener" data-magnetic>View more on AlgoMentor <span aria-hidden="true">↗</span></a>
      <span class="ps-note">Live from AlgoMentor · synced every few hours</span>
    </div>
  </div>
</section>
