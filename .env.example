# Copy to .env, or just run `npm run setup` which writes it for you.
ADMIN_EMAIL=you@example.com
# Generate with: npm run setup  (never commit a real hash or password)
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Public address of the site (canonical links, sitemap, structured data)
SITE_URL=https://example.com
# Postgres holds all content, logins and analytics. `npm run db:up` starts this one locally.
# On AWS use your RDS address, e.g. postgres://portfolio:PASSWORD@xxxx.rds.amazonaws.com:5432/portfolio?sslmode=require
DATABASE_URL=postgres://portfolio:portfolio@localhost:5433/portfolio
# Redis holds caches, login/visit rate limits and visitor de-duplication.
# Leave empty to use an in-process stand-in (fine for one server, lost on restart).
REDIS_URL=redis://localhost:6380
# Key prefix, so the portfolio can share a Redis with other apps
REDIS_PREFIX=portfolio:
# Uploaded images (when S3 is not used) and backups live here.
DATA_DIR=./data
# Image uploads go to S3 when S3_BUCKET is set (leave empty to keep them in DATA_DIR/uploads).
# On EC2, give the instance an IAM role with s3:PutObject, s3:GetObject and s3:DeleteObject
# on this bucket instead of putting access keys here. The bucket can stay private.
S3_BUCKET=
AWS_REGION=ap-south-1
S3_PREFIX=portfolio/media/
# Set to 1 only when running behind a reverse proxy you control (reads X-Forwarded-For)
TRUST_PROXY=0
HOST=0.0.0.0
PORT=4321

# Analytics: days roll over at midnight in this time zone
# ANALYTICS_TZ=Asia/Kolkata

# ---- Production on EC2 (docker-compose.prod.yml) ----
# The compose file builds DATABASE_URL and REDIS_URL itself from these, so you can leave
# the two URLs above out of the EC2 .env. Keep passwords URL-safe (letters, digits, - _).
# Admin login of the shared Postgres and the shared Redis password (same as your other stack):
POSTGRES_USER=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# The portfolio's own database and user inside shared-postgres (created on first start):
PORTFOLIO_DB=portfolio
PORTFOLIO_DB_USER=portfolio
PORTFOLIO_DB_PASSWORD=
# Host port, bound to 127.0.0.1 only; point nginx/Caddy at it
PORTFOLIO_PORT=4321

# Max image upload size in MB (default 25). If behind nginx, set client_max_body_size 30m;
# MAX_UPLOAD_MB=25
