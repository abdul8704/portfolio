# Copy to .env, or just run `npm run setup` which writes it for you.
ADMIN_EMAIL=you@example.com
# Generate with: npm run setup  (never commit a real hash or password)
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Public address of the site (canonical links, sitemap, structured data)
SITE_URL=https://example.com
# Where the database and uploaded images live. Back this folder up.
DATA_DIR=./data
# Set to 1 only when running behind a reverse proxy you control (reads X-Forwarded-For)
TRUST_PROXY=0
HOST=0.0.0.0
PORT=4321
